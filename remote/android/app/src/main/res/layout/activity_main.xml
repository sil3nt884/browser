<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/BarButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <EditText
            android:id="@+id/url"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/url_field"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/fg"
            android:textColorHint="@color/dim"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/reload"
            style="@style/BarButton"
            android:contentDescription="@string/reload"
            android:src="@drawable/ic_reload" />

        <ImageButton
            android:id="@+id/keyboard"
            style="@style/BarButton"
            android:contentDescription="@string/keyboard"
            android:src="@drawable/ic_keyboard" />

        <TextView
            android:id="@+id/tabs"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tab_count"
            android:contentDescription="@string/tabs"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/fg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/menu"
            style="@style/BarButton"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The page as video, decoded straight onto this surface
             (VideoDecoder); ScreenView on top takes the touches. -->
        <SurfaceView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <org.umbra.remote.ScreenView
            android:id="@+id/screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/dim"
            android:textSize="16sp" />

        <!-- Shown for a moment in full screen (and when the system bars are
             swiped in), to get the toolbar back. -->
        <ImageButton
            android:id="@+id/exit_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/round_scrim"
            android:contentDescription="@string/exit_full_screen"
            android:scaleType="center"
            android:src="@drawable/ic_fullscreen_exit"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
