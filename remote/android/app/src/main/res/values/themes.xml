<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform's own theme, so dialogs, menus and the keyboard look like
         the rest of the phone. -->
    <style name="Theme.UmbraRemote" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
